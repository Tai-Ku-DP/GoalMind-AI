# Simplamo API Client Rules

## Shared Axios Instance
Tất cả tool đều dùng chung 1 axios instance — không tự tạo fetch/axios mới:

```ts
// backend/src/simplamo/simplamo.client.ts
import axios, { AxiosInstance } from 'axios'
import { Injectable } from '@nestjs/common'
import { ConfigService } from '@nestjs/config'

@Injectable()
export class SimplamoClient {
  private readonly http: AxiosInstance

  constructor(private config: ConfigService) {
    this.http = axios.create({
      baseURL: 'https://api.simplamo.com/api',
      headers: {
        Authorization: `Bearer ${this.config.get('SIMPLAMO_API_TOKEN')}`,
        'Content-Type': 'application/json',
        'tenant-id': 'core',
        'content-language': 'en',
      },
      timeout: 10000,
    })
  }

  // Rocks (Goals)
  async listRocks(params: { teamId: string; sessionId: string; rock?: string; pic?: string }) {
    const { data } = await this.http.get('/eos-core/rocks', { params })
    return data  // returns array of rock objects directly
  }

  async getRockDetail(rockId: string) {
    const { data } = await this.http.get(`/eos-core/rocks/${rockId}`)
    return data
  }

  async updateRockStatus(rockId: string, status: 'ON_TRACK' | 'OFF_TRACK' | 'AT_RISK' | 'DONE') {
    const { data } = await this.http.patch(`/eos-core/rocks/${rockId}`, { status })
    return data
  }

  // Metrics
  async listMetrics(params?: { teamId?: string }) {
    const { data } = await this.http.get('/eos-core/metrics', { params })
    return data
  }

  async getMetricValues(metricId: string, params?: { from?: string; to?: string }) {
    const { data } = await this.http.get(`/eos-core/metrics/${metricId}/values`, { params })
    return data
  }

  async getTeamScorecard(teamId: string) {
    const { data } = await this.http.get('/eos-core/metrics/scorecard', { params: { teamId } })
    return data
  }

  // Actions
  async listActions(params?: { goalId?: string; status?: string; teamId?: string }) {
    const { data } = await this.http.get('/eos-core/actions', { params })
    return data
  }

  async createAction(payload: { title: string; goalId?: string; dueDate?: string; priority?: string; owner?: string }) {
    const { data } = await this.http.post('/eos-core/actions', payload)
    return data
  }

  async updateActionStatus(actionId: string, done: boolean) {
    const { data } = await this.http.patch(`/eos-core/actions/${actionId}`, { done })
    return data
  }
}
```

## Simplamo Module
```ts
// backend/src/simplamo/simplamo.module.ts
@Global()
@Module({
  providers: [SimplamoClient],
  exports: [SimplamoClient],
})
export class SimplamoModule {}
```

## API Endpoints (real Simplamo)
```
GET  /api/eos-core/rocks?teamId=&sessionId=  → danh sách rocks (array trực tiếp)
GET  /api/eos-core/rocks/:id                → chi tiết 1 rock
PATCH /api/eos-core/rocks/:id               → cập nhật rock status

GET  /api/eos-core/metrics?teamId=           → danh sách metrics/KPIs
GET  /api/eos-core/metrics/:id/values        → lịch sử giá trị thực tế
GET  /api/eos-core/metrics/scorecard?teamId= → scorecard của team

GET  /api/eos-core/actions?goalId=&status=   → danh sách actions (filter được)
POST /api/eos-core/actions                   → tạo action mới
PATCH /api/eos-core/actions/:id              → cập nhật trạng thái
```

## Required Headers
```
Authorization: Bearer <token>
Content-Type: application/json
tenant-id: core
content-language: en
```

